1 VERSIONINFO
FILEVERSION @VERSION_FIELDS@,0
PRODUCTVERSION @VERSION_FIELDS@,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0
FILEOS 0x00040004L
FILETYPE 1
FILESUBTYPE 0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "zapret-rust - Strategy selector and Telegram Desktop bridge\0"
            VALUE "FileVersion", "@VERSION@\0"
            VALUE "ProductName", "zapret-rust\0"
            VALUE "ProductVersion", "@VERSION@\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
